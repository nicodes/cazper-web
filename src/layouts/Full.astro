---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'cazper — Images with real transparency',
	description = 'Create and refine an image through a conversation, then download one transparent PNG.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://cazper.ai');
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'cazper',
	url: 'https://cazper.ai',
	applicationCategory: 'DesignApplication',
	operatingSystem: 'Web',
	description,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f4f5" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="cazper" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body><a class="skip-link" href="#main-content">Skip to content</a><slot /></body>
</html>
