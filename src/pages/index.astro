---
import Full from '../layouts/Full.astro';
import octicons from '@primer/octicons';

const appUrl = 'https://app.cazper.ai';
const icon = (name: keyof typeof octicons, size = 16) =>
	octicons[name].toSVG({ width: size, height: size });
---

<Full
	title="cazper — Make images with real transparency"
	description="Create and refine images with a real alpha channel. Start with a prompt or image, keep the conversation going, and download one transparent PNG."
>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="/" aria-label="cazper home">
				<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
					<path d="M16 3 28 10v12L16 29 4 22V10L16 3Z"></path>
					<path d="M11 11h5v5h-5zM16 16h5v5h-5z"></path>
				</svg>
				<span>cazper</span>
			</a>
			<a class="header-cta" href={appUrl}>Open app <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
		</header>

		<main id="main-content">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Prompt in, alpha out</p>
					<h1>A little imagination.<em>Real transparency.</em></h1>
					<p class="lede">Start with an idea or an image. Shape it through a conversation, then download a transparent PNG with the soft edges, glass and glow that make the artwork yours.</p>
					<div class="hero-actions">
						<a class="primary-cta" href={appUrl}>Launch cazper <span class="icon" set:html={icon('arrow-right', 16)} /></a>
						<p>Create in your browser</p>
					</div>
				</div>

				{/* Not a screenshot and not a mockup: both panes <use> the one <symbol>,
				    so the artwork is identical across them. The glass and the hole in the
				    key are genuinely semi-transparent, so the checkerboard shows through
				    exactly where it should and nowhere else. Astro drops {} comments from
				    the output, unlike <!-- -->, and this file is served as-is. */}
				<div class="product-frame" aria-label="artwork stuck on a white background, and the same artwork with real transparency">
					<div class="frame-bar">
						<div class="frame-brand"><span class="menu-lines"></span> cazper / transparency illustration</div>
						<div class="frame-actions"><span class="icon" set:html={icon('image', 13)} /><span class="icon" set:html={icon('sparkle-fill', 13)} /></div>
					</div>

					<svg class="sprite-source" aria-hidden="true" focusable="false">
						<defs>
							<clipPath id="flask"><circle cx="40" cy="47" r="24"></circle></clipPath>
							<symbol id="sprites" viewBox="0 0 240 80">
								<rect x="33" y="5" width="14" height="10" rx="2.5" fill="#8a6b4a"></rect>
								<rect x="35" y="14" width="10" height="11" fill="#7fd8c0" opacity=".5"></rect>
								<circle cx="40" cy="47" r="24" fill="#7fd8c0" opacity=".5"></circle>
								<rect x="16" y="45" width="48" height="30" fill="#2f9e6d" clip-path="url(#flask)"></rect>
								<ellipse cx="30" cy="38" rx="4.5" ry="8" fill="#ffffff" opacity=".42" transform="rotate(-22 30 38)"></ellipse>

								<path d="M120 7 147 33 120 73 93 33Z" fill="#4dabf7" opacity=".55"></path>
								<path d="M120 7 147 33 120 73Z" fill="#1c7ed6" opacity=".92"></path>
								<path d="M120 7 106 33h28Z" fill="#a5d8ff" opacity=".95"></path>

								<g fill="#e0b445">
									<path fill-rule="evenodd" d="M200 9a13 13 0 1 0 0 26 13 13 0 0 0 0-26Zm0 7.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Z"></path>
									<rect x="196" y="33" width="8" height="39" rx="1.5"></rect>
									<rect x="204" y="51" width="9" height="6" rx="1.5"></rect>
									<rect x="204" y="62" width="13" height="6" rx="1.5"></rect>
								</g>
							</symbol>
						</defs>
					</svg>

					<div class="panes">
						<figure class="pane on-white">
							<svg viewBox="0 0 240 80" role="img" aria-label="Illustrated potion, gem and key with partially transparent edges"><use href="#sprites"></use></svg>
							<figcaption>white background</figcaption>
						</figure>
						<figure class="pane on-alpha">
							<svg viewBox="0 0 240 80" role="img" aria-label="Illustrated potion, gem and key with partially transparent edges"><use href="#sprites"></use></svg>
							<figcaption>alpha illustration</figcaption>
						</figure>
					</div>

					<div class="frame-keys">
						<span>in</span> a prompt or image<i></i><span>out</span> one transparent PNG
					</div>
				</div>
			</section>

<section class="principles" aria-label="Make it your own">
<article><span class="number">01</span><div><h2>Begin anywhere</h2><p>Describe the image you have in mind, or bring an image to work from. A prompt and an upload are both ways to start.</p></div></article>
<article><span class="number">02</span><div><h2>Keep the conversation going</h2><p>Ask for a change in the same chat. Follow-up prompts edit the latest image, so you can refine it one step at a time.</p></div></article>
<article><span class="number">03</span><div><h2>Take the PNG with you</h2><p>Download one image with a real alpha channel, ready to place over your own background. Your successful image chats stay in your library.</p></div></article>
</section>
<section class="clients-section" aria-label="A conversation with your image"><div class="section-head"><p class="eyebrow"><span></span> CREATE · REFINE · DOWNLOAD</p><h2>Your next image starts with a conversation.</h2><p>Work from a new prompt, build on an image, or return to something in your library. The gallery gives you another place to explore what’s been made.</p><p class="aside">The illustration above demonstrates partial transparency; it is not a captured product result.</p><a class="primary-cta" href={appUrl}>Start an image <span class="icon" set:html={icon('arrow-right', 16)} /></a></div></section>
			<section class="closing">
				<p>Imagine it.<br />Make it yours.</p>
				<div class="chain"><span>PROMPT</span><i></i><span>CAZPER</span><i></i><span>TRANSPARENT PNG</span></div>
				<div class="closing-actions">
					<a class="primary-cta light" href={appUrl}>Open cazper <span class="icon" set:html={icon('arrow-right', 16)} /></a>
				</div>
			</section>
		</main>

		<footer>
			<a class="brand footer-brand" href="/"><span>cazper</span></a>
			<p><a href={appUrl}>app</a></p>
			<p>© {new Date().getFullYear()} cazper</p>
		</footer>
	</div>
</Full>

<style>
	.page-shell { min-height: 100svh; overflow-x: hidden; }
	.site-header { width: min(1180px, calc(100% - 40px)); height: 76px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 19px; font-weight: 760; letter-spacing: -.03em; text-decoration: none; }
	.brand-mark { width: 27px; height: 27px; }
	.brand-mark path:first-child { fill: var(--ink); }
	.brand-mark path:last-child { fill: var(--emerald); }
	.header-cta { display: inline-flex; align-items: center; color: var(--ink); border-bottom: 1px solid #c7c7cc; padding: 6px 0; font-size: 13px; font-weight: 650; text-decoration: none; white-space: nowrap; }
	.header-cta span { margin-left: 5px; color: var(--emerald-dark); }
	:global(.icon svg) { display: block; fill: currentColor; }

	.hero { width: min(1180px, calc(100% - 40px)); margin: 70px auto 110px; display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: 70px; }
	.hero-copy { position: relative; z-index: 2; }
	.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: var(--quiet); font: 620 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
	.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--emerald-dark); box-shadow: 0 0 0 4px rgba(5, 150, 105, .12); }
	h1 { max-width: 600px; margin: 0; color: var(--ink); font-size: clamp(46px, 6vw, 78px); font-weight: 590; line-height: .98; letter-spacing: -.062em; }
	/* Block so the second clause always starts its own line. Left inline it
	   orphans "not" onto the end of "transparency," on a narrow screen. */
	h1 em { display: block; color: var(--emerald-dark); font-family: Georgia, serif; font-weight: 400; }
	.lede { max-width: 520px; margin: 30px 0 32px; color: var(--quiet); font-size: 16px; line-height: 1.7; }
	.hero-actions { display: flex; align-items: center; gap: 20px; }
	.hero-actions p { margin: 0; color: #8b8b93; font: 500 10px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .05em; }
	.primary-cta { display: inline-flex; align-items: center; gap: 30px; border-radius: 4px; background: var(--ink); color: white; padding: 14px 18px; font: 680 13px var(--sans); text-decoration: none; transition: transform .18s ease, background .18s ease; }
	.primary-cta:hover { transform: translateY(-2px); background: #2a2a2e; }
	.primary-cta span { color: var(--emerald); }

	.product-frame { position: relative; min-width: 680px; border: 1px solid #d6d6da; border-radius: 9px; background: white; box-shadow: 0 35px 80px rgba(24, 24, 27, .13), 0 3px 10px rgba(24, 24, 27, .07); overflow: hidden; transform: perspective(1400px) rotateY(-3deg) rotateX(1deg); }
	.product-frame::before { content: ''; position: absolute; z-index: -1; width: 340px; height: 340px; right: -70px; top: -90px; border-radius: 50%; background: var(--emerald); filter: blur(80px); opacity: .3; }
	.frame-bar { height: 42px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e7e7ea; padding: 0 13px; color: #55555d; font: 600 10px var(--mono); }
	.frame-brand, .frame-actions { display: flex; align-items: center; gap: 11px; }
	.menu-lines { width: 13px; height: 8px; border-block: 1px solid #78787f; position: relative; }
	.menu-lines::after { content: ''; position: absolute; left: 0; right: 0; top: 3px; border-top: 1px solid #78787f; }
	.frame-actions span { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 4px; background: #f1f1f3; color: #45454b; }

	/* The <symbol> lives here and is never painted directly. Both panes are
	   <use> references to it, which is what makes them the same artwork. */
	.sprite-source { position: absolute; width: 0; height: 0; }
	/* Stacked rather than side by side: two columns would give each sprite half
	   the frame, and the whole point is to look closely at the edges. */
	.panes { display: grid; }
	.pane { position: relative; margin: 0; padding: 22px 64px 22px 24px; }
	.pane + .pane { border-top: 1px solid #e7e7ea; }
	.pane svg { display: block; width: 100%; height: auto; }
	.pane figcaption { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); font: 600 8.5px var(--mono); letter-spacing: .14em; text-transform: uppercase; writing-mode: vertical-rl; }
	.on-white { background: #ffffff; }
	.on-white figcaption { color: #a1a1aa; }
	/* The alpha pane is a checkerboard for the reason every image editor uses
	   one: against a flat fill, a transparent PNG and an opaque one of that
	   colour are the same picture. */
	.on-alpha { background-color: #ffffff; background-image: linear-gradient(45deg, #d9d9de 25%, transparent 25%), linear-gradient(-45deg, #d9d9de 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #d9d9de 75%), linear-gradient(-45deg, transparent 75%, #d9d9de 75%); background-size: 16px 16px; background-position: 0 0, 0 8px, 8px -8px, -8px 0; }
	.on-alpha figcaption { color: var(--emerald-dark); }
	.frame-keys { min-height: 34px; display: flex; flex-wrap: wrap; align-items: center; gap: 9px; border-top: 1px solid #1e1e21; background: #0a0c0b; padding: 8px 20px; color: #74747c; font: 9.5px var(--mono); }
	.frame-keys span { color: var(--emerald); font: inherit; font-weight: 500; }
	.frame-keys i { width: 3px; height: 3px; border-radius: 50%; background: #35353a; }

	.principles { width: min(1180px, calc(100% - 40px)); margin: 0 auto 120px; border-top: 1px solid #d8d8dc; }
	.principles article { display: grid; grid-template-columns: 90px 1fr; border-bottom: 1px solid #d8d8dc; padding: 32px 0; }
	.principles article div { display: grid; grid-template-columns: .75fr 1fr; align-items: baseline; gap: 40px; }
	.number { color: var(--emerald-dark); font: 650 10px var(--mono); }
	.principles h2 { margin: 0; color: var(--ink); font-size: 22px; font-weight: 580; letter-spacing: -.035em; }
	.principles p { max-width: 560px; margin: 0; color: var(--quiet); font-size: 14px; line-height: 1.65; }
	.principles code { border-radius: 3px; background: #e5e5e9; padding: 1px 5px; font: 12px var(--mono); }

	.clients-section { width: min(1180px, calc(100% - 40px)); margin: 0 auto 110px; }
	.section-head { max-width: 620px; margin-bottom: 40px; }
	.section-head h2 { margin: 0 0 22px; color: var(--ink); font-size: clamp(32px, 4vw, 46px); font-weight: 560; line-height: 1.02; letter-spacing: -.05em; }
	.section-head p { margin: 0 0 14px; color: var(--quiet); font-size: 15px; line-height: 1.7; }
	.section-head .aside { max-width: 580px; color: #7c7c85; font-size: 13.5px; }
	.product-frame.wide { min-width: 0; width: 100%; max-width: 100%; transform: none; }

	.closing { width: min(1180px, calc(100% - 40px)); margin: 0 auto; border-radius: 8px; background: var(--ink); color: white; padding: 65px; }
	.closing > p { max-width: 680px; margin: 0 0 50px; font-size: clamp(42px, 6vw, 72px); font-weight: 530; line-height: .98; letter-spacing: -.055em; }
	.chain { display: flex; flex-wrap: wrap; align-items: center; gap: 13px; margin-bottom: 35px; color: #9b9ba3; font: 560 9px var(--mono); letter-spacing: .09em; }
	.chain i { width: 50px; border-top: 1px dashed #55555c; }
	.closing-actions { display: flex; align-items: center; gap: 22px; }
	.primary-cta.light { background: var(--emerald); color: #06251a; }
	.primary-cta.light span { color: #06251a; }

	footer { width: min(1180px, calc(100% - 40px)); min-height: 120px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; color: #8b8b93; font: 500 10px var(--mono); }
	footer p:nth-child(2) { text-align: center; }
	footer p:last-child { text-align: right; }
	footer a { color: #8b8b93; text-decoration: none; border-bottom: 1px solid #d0d0d5; }
	footer a:hover { color: var(--ink); }
	/* Written as `footer a.footer-brand` rather than `.footer-brand`: scoped
	   styles add an attribute selector per compound selector, so the two-element
	   `footer a` above outranks a lone class and keeps its underline. */
	footer a.footer-brand { justify-self: start; font-family: var(--sans); font-size: 16px; border: 0; }

	@keyframes blink { 50% { opacity: 0; } }

	@media (max-width: 900px) {
		.hero { grid-template-columns: 1fr; margin-top: 45px; gap: 60px; }
		.hero-copy { max-width: 680px; }
		.product-frame { min-width: 0; width: 100%; transform: none; }
		.principles article div { grid-template-columns: 1fr; gap: 9px; }
	}
	@media (max-width: 600px) {
		.site-header, .hero, .principles, .clients-section, .closing, footer { width: min(100% - 28px, 1180px); }
		.site-header { height: 64px; }
		.hero { margin: 48px auto 80px; }
		.eyebrow { margin-bottom: 18px; }
		h1 { font-size: clamp(42px, 13vw, 60px); }
		.lede { margin-top: 24px; font-size: 15px; }
		.hero-actions { align-items: flex-start; flex-direction: column; gap: 12px; }
		.product-frame { border-radius: 6px; }
		.pane { padding: 14px 40px 14px 14px; }
		.pane figcaption { right: 10px; font-size: 7.5px; letter-spacing: .1em; }
		.frame-keys { padding: 7px 12px; font-size: 8.5px; }
		.section-head { margin-bottom: 28px; }
		.principles article { grid-template-columns: 42px 1fr; padding: 26px 0; }
		.principles h2 { font-size: 19px; }
		.principles p { font-size: 13px; }
		.closing { padding: 40px 25px; }
		.closing > div { flex-wrap: wrap; }
		.closing > div i { width: 20px; }
		.closing-actions { flex-direction: column; align-items: flex-start; gap: 16px; }
		footer { grid-template-columns: 1fr auto; padding: 30px 0; }
		.footer-brand { display: none; }
		footer p:nth-child(2) { text-align: left; }
	}


/* A lightbox for artwork: rounded, generous, with the alpha comparison as the centerpiece. */
.hero { grid-template-columns: 1fr; text-align: center; margin: 80px auto 96px; gap: 56px; }
.hero-copy { max-width: 900px; margin: auto; }
.eyebrow { justify-content: center; color: #08734f; }
h1 { max-width: 900px; font-size: clamp(54px, 7.8vw, 104px); font-weight: 750; line-height: 1.03; letter-spacing: -.06em; }
h1 em { font-family: var(--sans); font-style: normal; color: #08734f; }
.lede { max-width: 650px; margin: 28px auto; font-size: 18px; }
.hero-actions { justify-content: center; flex-wrap: wrap; }
.hero-actions p { color: #52525b; }
.primary-cta { border-radius: 100px; background: #08734f; padding: 17px 25px; }
.primary-cta:hover { background: #065f46; }
.product-frame { min-width: 0; width: 100%; border-radius: 24px; transform: none; box-shadow: 0 18px 60px #18181b12; }
.product-frame::before { display: none; }
.panes { display: grid; grid-template-columns: 1fr 1fr; }
.pane + .pane { border-left: 1px solid #d4d4d8; border-top: 0; }
.pane { height: 300px; margin: 0; }
.pane svg { width: 88%; height: 225px; }
.frame-bar { height: 48px; background: #fafafa; }
.principles { border: 0; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 28px; }
.principles article { display: block; padding: 28px; border: 0; background: white; border-radius: 20px; }
.principles article div { display: block; }
.number { display: inline-block; margin-bottom: 24px; font-size: 14px; color: #08734f; }
.principles h2 { font-size: 23px; margin-bottom: 15px; }
.clients-section { grid-template-columns: 1fr 1.2fr; align-items: center; gap: 60px; }
.closing { text-align: center; border-radius: 28px; background: #d7f5e5; color: #073d2b; }
.closing > p { max-width: none; font-weight: 700; }
.chain, .closing-actions { justify-content: center; }
.chain { color: #27604c; }
@media (max-width: 900px) { .principles { grid-template-columns: 1fr; gap: 12px; } .clients-section { grid-template-columns: 1fr; gap: 30px; } }
@media (max-width: 600px) { .hero { margin-top: 45px; gap: 35px; } h1 { font-size: 48px; } .lede { font-size: 16px; } .hero-actions { align-items: center; } .panes { grid-template-columns: 1fr; } .pane + .pane { border-left: 0; border-top: 1px solid #d4d4d8; } .pane { height: 250px; } .pane svg { height: 190px; } .closing { padding: 40px 20px; } }


.clients-section .eyebrow { justify-content: flex-start; }

footer, footer a { color: #59636a; }
</style>
